# Generate local values with python scripts/bootstrap_demo.py .local/demo
# and use: docker compose --env-file .local/demo/demo.env --profile demo up --build
FORECAST_ANYTHING_WORKSPACE_TOKEN=
FORECAST_ANYTHING_CONSOLE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FORECAST_ANYTHING_DATA_DIR=./.local/demo
# Native Python commands use this host path. Containers always use /data/state.db.
FORECAST_ANYTHING_DATABASE=./.local/demo/state.db
